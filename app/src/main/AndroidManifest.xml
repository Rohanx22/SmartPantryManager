<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.smartpantrymanager">

    <!-- Note: No location or mapping permissions are used, strictly adhering to the MAD700 project scope -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Default Launcher Activity: Pantry List Screen (Chapter 5 pattern) -->
        <activity
            android:name=".PantryListActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Add / Edit Pantry Ingredient Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="Add / Edit Ingredient" />

        <!-- Suggested Recipes Screen (Strict-Matching & Almost There) -->
        <activity
            android:name=".SuggestedRecipesActivity"
            android:exported="false"
            android:label="Suggested Recipes" />

        <!-- Recipe Detail Screen -->
        <activity
            android:name=".RecipeDetailActivity"
            android:exported="false"
            android:label="Recipe Details" />

        <!-- Settings Screen (SharedPreferences) -->
        <activity
            android:name=".PantrySettingsActivity"
            android:exported="false"
            android:label="Pantry Settings" />

    </application>

</manifest>
